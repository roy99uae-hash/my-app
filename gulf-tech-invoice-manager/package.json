{
  "name": "gulf-tech-dubai-invoice-manager",
  "productName": "Gulf Tech Dubai Invoice Manager",
  "version": "1.0.0",
  "description": "Offline invoice & billing management desktop application for Windows",
  "author": "Gulf Tech Dubai",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build:renderer": "vite build",
    "start": "vite build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui/run.mjs",
    "test:all": "npm test && npm run test:ui",
    "build:win": "npm run test:all && vite build && electron-builder --win nsis --x64",
    "build:win:portable": "npm run test:all && vite build && electron-builder --win portable --x64",
    "pack": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "lucide-react": "1.53.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.1.0",
    "vite": "8.3.3"
  },
  "build": {
    "appId": "com.gultech.dubai.invoicemanager",
    "productName": "Gulf Tech Dubai Invoice Manager",
    "artifactName": "GulfTechInvoiceManager-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gulf Tech Dubai Invoice Manager",
      "uninstallDisplayName": "Gulf Tech Dubai Invoice Manager",
      "license": "LICENSE.txt"
    }
  }
}
